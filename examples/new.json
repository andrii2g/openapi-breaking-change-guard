{
  "openapi": "3.1.0",
  "info": {
    "title": "Widget API",
    "version": "2.0.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "responses": {
          "204": {
            "description": "Healthy."
          }
        }
      }
    },
    "/v1/widgets": {
      "get": {
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Widget list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Widget"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ToolError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Widget": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "active"
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ToolError"
              },
              {
                "type": "null"
              }
            ]
          },
          "tag": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "tag"
        ]
      }
    }
  }
}

