{
  "openapi": "3.1.0",
  "info": {
    "title": "Widget API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/legacy": {
      "get": {
        "responses": {
          "204": {
            "description": "Legacy check succeeded."
          }
        }
      }
    },
    "/v1/widgets": {
      "get": {
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Widget list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Widget"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No widgets were found."
          }
        }
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Widget"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Widget created."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ToolError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Widget": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/components/schemas/ToolError"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "status"
        ]
      }
    }
  }
}

