<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>OpenApiBreakingChangeGuard.Tests</AssemblyName>
    <RootNamespace>OpenApiBreakingChangeGuard.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.MTP" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OpenApiBreakingChangeGuard.Core/OpenApiBreakingChangeGuard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

